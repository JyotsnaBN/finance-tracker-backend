# Finance Tracker — local development environment variables
# Copy this file to backend/.env and fill in your dev values.
# Never commit the real .env file (it is already in .gitignore).

# ---------------------------------------------------------------------------
# Backend only — consumed by the Spring application at runtime
# ---------------------------------------------------------------------------

ENCRYPTION_SECRET_KEY=  # Exactly 32 chars (AES-256-GCM key)

GOOGLE_CLIENT_ID=       # Google Cloud Console OAuth2 client ID
GOOGLE_CLIENT_SECRET=   # Google Cloud Console OAuth2 client secret
GOOGLE_REDIRECT_URI=    # http://localhost:8080/api/email/oauth/callback

EMAIL_SYNC_FREQUENCY_MS=    # Polling interval in ms, e.g. 3600000 (1 h)
EMAIL_SYNC_MAX_RESULTS=     # Max emails to fetch per sync, e.g. 100
EMAIL_SYNC_LOOKBACK_DAYS=   # How far back to scan on first sync, e.g. 30

DATABASE_URL=           # JDBC URL: jdbc:postgresql://db.<ref>.supabase.co:5432/postgres
DATABASE_USERNAME=      # DB user (usually 'postgres')
DATABASE_PASSWORD=      # DB password

JWT_SECRET=             # Min 32 chars, random string

PORT=                   # Server port, defaults to 8080 if unset

MIGRATION_ACCOUNT_NUMBER_ENABLED=  # true | false (default: false)

MAIL_FROM=          # Sender address shown in report emails — must match a verified Resend sender
RESEND_API_KEY=     # API key from resend.com (https://resend.com/api-keys)

# ---------------------------------------------------------------------------
# Both — needed by the backend at runtime AND referenced in GitHub Actions
# ---------------------------------------------------------------------------

# Dev values go here; add PROD_ equivalents as GitHub Actions secrets for prod.

BACKEND_BASE_URL=   # e.g. http://localhost:8080 — used by email-processing & report workflows
INTERNAL_API_KEY=   # Random string for X-API-KEY header (email processing endpoint)

# ---------------------------------------------------------------------------
# GitHub Actions only — no backend equivalent; add as repo/environment secrets
# ---------------------------------------------------------------------------

# Dev report workflow login (Finance Tracker app account credentials):
# REPORT_USER_EMAIL
# REPORT_USER_PASSWORD

# Prod equivalents:
# PROD_BACKEND_BASE_URL
# PROD_INTERNAL_API_KEY
# PROD_REPORT_USER_EMAIL
# PROD_REPORT_USER_PASSWORD

# ---------------------------------------------------------------------------
# Rate limiting — all optional, defaults shown in application.properties
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_IP=          # Max auth requests per IP per window (default: 10)
RATE_LIMIT_AUTH_WINDOW_SECS= # Auth IP window in seconds (default: 60)
RATE_LIMIT_AUTH_ACCOUNT=     # Max auth requests per account per window (default: 5)
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SECS= # Auth account window in seconds (default: 60)
RATE_LIMIT_USER_ACTION=      # Max requests per authenticated user per window (default: 200)
RATE_LIMIT_USER_ACTION_WINDOW_SECS=  # User-action window in seconds (default: 60)
RATE_LIMIT_PUBLIC=           # Max requests per IP on public routes (default: 60)
RATE_LIMIT_PUBLIC_WINDOW_SECS=       # Public route window in seconds (default: 60)
